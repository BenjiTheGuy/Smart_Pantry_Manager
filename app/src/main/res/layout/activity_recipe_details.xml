<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/white"
    android:fillViewport="true" >

    <!-- Allows the recipe details to scroll when content exceeds the screen height -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp" >

        <!-- Displays the name of the selected recipe -->
        <TextView
            android:id="@+id/txt_detail_recipe_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="#222222" />

        <!-- Heading for the recipe's required ingredients -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/ingredients_required"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#222222" />

        <!-- Displays each required ingredients with its quantity and unit -->
        <TextView
            android:id="@+id/txt_detail_ingredients"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textSize="16sp"
            android:textColor="#444444"
            android:lineSpacingExtra="6dp" />

        <!-- Heading for the recipe preparation instructions -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/ingredients_instructions"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#222222" />

        <!-- Displays the full preparation instructions for the selected recipe. -->
        <TextView
            android:id="@+id/txt_detail_instructions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textSize="16sp"
            android:textColor="#444444"
            android:lineSpacingExtra="6dp" />

    </LinearLayout>

</ScrollView>