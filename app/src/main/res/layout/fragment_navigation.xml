<?xml version="1.0" encoding="utf-8"?>
<!-- Linear Layout used for Navigation -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center"
    android:paddingTop="10dp"
    android:paddingBottom="10dp"
    android:background="@color/pantry_cream" >

    <!-- Pantry Button -->
    <Button
        android:id="@+id/nav_pantry"
        android:layout_height="wrap_content"
        android:layout_width="0dp"
        android:layout_weight="1"
        android:text="@string/nav_pantry"
        android:textSize="12sp"
        android:textStyle="bold"
        android:textColor="@color/pantry_green_dark"
        android:backgroundTint="@color/pantry_green_light" />

    <!-- Recipes Button -->
    <Button
        android:id="@+id/nav_recipes"
        android:layout_height="wrap_content"
        android:layout_width="0dp"
        android:layout_weight="1"
        android:text="@string/nav_recipes"
        android:textSize="12sp"
        android:textStyle="bold"
        android:textColor="@color/pantry_green_dark"
        android:backgroundTint="@color/pantry_green_light" />

    <!-- Settings Button -->
    <Button
        android:id="@+id/nav_settings"
        android:layout_height="wrap_content"
        android:layout_width="0dp"
        android:layout_weight="1"
        android:text="@string/nav_settings"
        android:textSize="12sp"
        android:textStyle="bold"
        android:textColor="@color/pantry_green_dark"
        android:backgroundTint="@color/pantry_green_light" />

</LinearLayout>