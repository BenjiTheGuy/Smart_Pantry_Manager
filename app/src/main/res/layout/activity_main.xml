<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/pantry_background"
    tools:context=".MainActivity">

    <!-- App Title -->
    <TextView
        android:id="@+id/p_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="20dp"
        android:text="@string/app_name"
        android:textStyle="bold|italic"
        android:textSize="28sp"
        android:textColor="@color/pantry_green_dark"
        app:layout_constraintBottom_toTopOf="@id/p_heading"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Personal Greeting -->
    <TextView
        android:id="@+id/p_welcome_back"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:text="Welcome Back!"
        android:textColor="@color/pantry_text_secondary"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/p_title"
        app:layout_constraintBottom_toTopOf="@id/p_heading"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Heading -->
    <TextView
        android:id="@+id/p_heading"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:paddingTop="15dp"
        android:text="@string/pantry_heading"
        android:textSize="24sp"
        android:textStyle="normal|bold"
        android:textColor="@color/pantry_text_primary"
        app:layout_constraintTop_toBottomOf="@id/p_title"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- List displaying saved pantry ingredients -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_pantry"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:padding="8dp"
        android:clipToPadding="false"
        app:layout_constraintTop_toBottomOf="@id/p_heading"
        app:layout_constraintBottom_toTopOf="@id/add_ingredient"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Temporary Empty-State Message -->
    <TextView
        android:id="@+id/p_empty_pantry"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="15dp"
        android:gravity="center"
        android:padding="16dp"
        android:text="@string/empty_pantry_message"
        android:textColor="@color/pantry_text_secondary"
        android:textSize="16sp"
        app:layout_constraintTop_toTopOf="@id/rv_pantry"
        app:layout_constraintBottom_toBottomOf="@id/rv_pantry"
        app:layout_constraintStart_toStartOf="@id/rv_pantry"
        app:layout_constraintEnd_toEndOf="@id/rv_pantry" />

    <!-- Add Ingredient Button -->
    <Button
        android:id="@+id/add_ingredient"
        android:layout_height="wrap_content"
        android:layout_width="wrap_content"
        android:layout_marginBottom="8dp"
        android:backgroundTint="@color/pantry_green"
        android:text="@string/add_ingredient"
        android:textColor="@color/white"
        android:textSize="16sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toTopOf="@id/fragment_navigation"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Navigation Fragment -->
    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/fragment_navigation"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>